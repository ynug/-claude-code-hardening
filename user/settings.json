{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "tui": "fullscreen",
  "theme": "dark",
  "env": {
    "NPM_CONFIG_IGNORE_SCRIPTS": "true"
  },
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Edit(**/.github/**)",
      "Edit(**/.vscode/**)",
      "Edit(**/.envrc)",
      "Bash(curl *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "WebFetch"
    ]
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowRead": [
        "~/.local/share/mise"
      ],
      "allowWrite": [
        "~/.npm"
      ]
    }
  }
}
